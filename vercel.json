{
  "routes": [
    {
      "src": "/(.*\\.(js|css|png|jpg|svg|ico|woff|woff2))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?!www|hashcommerce)(.+)\\.hashcommerce\\.site"
        }
      ],
      "dest": "/store.html"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
